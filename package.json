{
  "name": "lenszap",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "A Chromium extension that hides page blocks off your LensPub lens, with a local decision model. Built on LensPub; not a LensPub engine.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node test/run-tests.mjs && node test/repo-checks.mjs",
    "test:watch": "node --watch-path=core --watch-path=test --watch-path=eval test/run-tests.mjs",
    "dev": "node scripts/dev.mjs",
    "bench": "node bench/bench.mjs",
    "browser-check": "node test/browser-check.mjs",
    "check-upstream": "node scripts/check-upstream.mjs",
    "version": "node scripts/version.mjs sync",
    "check-version": "node scripts/version.mjs check",
    "capture": "node eval/capture.mjs",
    "label": "node eval/label.mjs",
    "eval": "node eval/run.mjs",
    "compare-models": "node eval/compare-models.mjs",
    "history-lens": "node --no-warnings=ExperimentalWarning eval/history-lens.mjs",
    "browser-scorer": "node eval/browser-scorer.mjs",
    "two-pass": "node eval/two-pass.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0"
  }
}
