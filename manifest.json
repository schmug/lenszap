{
  "manifest_version": 3,
  "name": "LensZap (built on LensPub; not a LensPub engine)",
  "version": "0.3.0",
  "description": "Hides page blocks that don't match your LensPub lens. Uses your lens, but unlike a LensPub engine it hides content. Runs locally; every zap is listed and restorable.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/zap.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LensZap"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "core/*.js",
        "content/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
